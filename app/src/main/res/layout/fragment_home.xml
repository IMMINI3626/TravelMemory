<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Travel Memory"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="나만의 여행 기록을 남겨보세요"
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"
            android:paddingBottom="32dp" />

        <!-- 총 기록 수 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="총 0개의 여행 기록"
                android:textSize="16sp"
                android:textColor="#1A237E"
                android:gravity="center"
                android:padding="20dp" />

        </androidx.cardview.widget.CardView>

        <!-- 최근 여행 카드 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="최근 여행지"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvRecentPlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아직 기록이 없어요"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

                <TextView
                    android:id="@+id/tvRecentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:paddingTop="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAddTravel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ 새 여행 기록 추가"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>